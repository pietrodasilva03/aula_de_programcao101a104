programa {
  funcao inicio() {
    inteiro numero[5] = { 0,1, 2 , 3 , 4}
    inteiro n , m
    
    numero[0]
    numero[1]
    numero[2]
    numero[3]
    numero[4]

    escreva("Digite o valor de N : " )
    leia(n)
    
    escreva("Digite o valor de m : " )
    leia(m)

    numero[0] = n
    numero[1] = m


    escreva(numero)

  }
}
